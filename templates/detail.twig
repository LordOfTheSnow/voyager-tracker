{% extends "layout.twig" %}

{% block title %}{{ probe.name }} — Voyager Distance Tracker{% endblock %}

{% block content %}

<a href="/" class="back-link"><i class="ph ph-arrow-left"></i>Back to overview</a>

<div class="page-header">
  <div>
    <h6 style="color:var(--color-accent)">SPACECRAFT</h6>
    <h1 style="margin:0 0 4px">{{ probe.name }}</h1>
    <p class="text-muted" style="margin:0;font-size:13px">Launched {{ probe.launchDateLabel }} &middot; {{ probe.subtitleFact }}</p>
  </div>
  <span class="tag {{ probe.inContact ? 'tag-accent' : 'tag-neutral' }}" style="font-size:12px"><i class="ph ph-broadcast"></i>{{ probe.signalLabel }}{% if probe.dishFlagSrc %} <img src="{{ probe.dishFlagSrc }}" alt="{{ probe.dishFlagAlt }}" title="{{ probe.dishLocation }}" class="flag-icon">{% endif %}</span>
</div>

<div class="detail-stats">
  <div class="card elev-sm">
    <span class="card-kicker">Distance from Sun</span>
    <div class="detail-stat-value detail-stat-value-precise">{{ probe.distanceFromSunPrecise }}</div>
    <div class="text-muted detail-stat-sub">{{ probe.distanceFromSunAu }} &middot; {{ probe.distanceFromSunMiPrecise }}</div>
  </div>
  <div class="card elev-sm">
    <span class="card-kicker">Distance from Earth</span>
    <div class="detail-stat-value detail-stat-value-precise">{{ probe.distanceFromEarthPrecise }}</div>
    <div class="text-muted detail-stat-sub">{{ probe.distanceFromEarthAu }} &middot; {{ probe.distanceFromEarthMiPrecise }}</div>
  </div>
  <div class="card elev-sm">
    <span class="card-kicker">Speed</span>
    <div class="detail-stat-value">{{ probe.speed }}</div>
    <div class="text-muted detail-stat-sub">{{ probe.speedKmH }} &middot; {{ probe.speedMph }}</div>
  </div>
  <div class="card elev-sm">
    <span class="card-kicker">One-way light time</span>
    <div class="detail-stat-value">{{ probe.oneWayLightTime }}</div>
    {% if probe.lightDayCrossingLabel %}<div class="text-muted detail-stat-sub" style="cursor:help" title="Uses Horizons' light-time-corrected one-way light time — the true travel time of the light arriving right now. Other trackers using the probe's instantaneous (not light-time-corrected) distance can land up to ~16 hours earlier for the same crossing.">{{ probe.lightDayCrossingLabel }}</div>{% endif %}
  </div>
</div>

<div class="detail-two-col">

  <div class="card elev-sm" style="padding:var(--space-4)">
    <span class="card-kicker">Angle against the ecliptic</span>
    {% set d = probe.eclipticDiagram %}
    <svg width="100%" height="260" viewBox="0 0 400 260" style="display:block;margin:var(--space-2) 0">
      <path d="M {{ d.heliopauseTop.x }} {{ d.heliopauseTop.y }} A {{ d.heliopauseRadius }} {{ d.heliopauseRadius }} 0 0 1 {{ d.heliopauseBottom.x }} {{ d.heliopauseBottom.y }}" fill="none" stroke="var(--color-sun)" stroke-width="1.5" stroke-dasharray="6 5" opacity=".8"/>
      <text x="{{ d.heliopauseLabelX }}" y="{{ d.sun.y - 8 }}" font-size="9px" fill="var(--color-sun)" opacity=".9">Heliopause (approx.)</text>

      <line x1="{{ d.sun.x }}" y1="{{ d.sun.y }}" x2="{{ d.planeEndX }}" y2="{{ d.sun.y }}" stroke="var(--color-neutral-600)" stroke-width="1"/>
      <text x="{{ d.planeEndX - 88 }}" y="{{ d.sun.y + 16 }}" font-size="9px" fill="var(--color-neutral-500)">Ecliptic plane</text>

      <line x1="{{ d.sun.x }}" y1="{{ d.sun.y }}" x2="{{ d.probe.x }}" y2="{{ d.probe.y }}" stroke="var(--color-accent-2)" stroke-width="2" stroke-dasharray="1 5" stroke-linecap="round"/>
      <path d="M {{ d.arcStart.x }} {{ d.arcStart.y }} A {{ d.arcRadius }} {{ d.arcRadius }} 0 0 {{ d.arcSweepFlag }} {{ d.arcEnd.x }} {{ d.arcEnd.y }}" fill="none" stroke="var(--color-accent)" stroke-width="1" opacity=".7"/>
      <text x="{{ d.arcLabel.x }}" y="{{ d.arcLabel.y }}" font-size="11px" fill="var(--color-accent)" text-anchor="middle">{{ d.angleLabel }}</text>

      <circle cx="{{ d.sun.x }}" cy="{{ d.sun.y }}" r="9" fill="var(--color-accent)"/>
      <text x="{{ d.sun.x - 12 }}" y="{{ d.sun.y + 25 }}" font-size="10px" fill="var(--color-neutral-500)">Sun</text>

      <circle cx="{{ d.probe.x }}" cy="{{ d.probe.y }}" r="5" fill="var(--color-accent)" class="pulse-dot {{ probe.inContact ? '' : 'is-dormant' }}"/>
      <text x="{{ d.probe.x - 45 }}" y="{{ d.probeLabelY }}" font-size="12px" fill="var(--color-text)">{{ probe.name }}</text>
    </svg>
    <p class="card-body" style="opacity:.75">Heading {{ probe.heading }}, currently about {{ d.angleLabel }} {{ d.directionWord }} the ecliptic plane &mdash; a nearly constant angle, since both Voyagers are now moving essentially radially outward from the Sun. Left the heliopause on {{ probe.heliopauseCrossingLabel }} and is now in interstellar space.</p>
  </div>

  <div class="card elev-sm" style="padding:var(--space-4)">
    <span class="card-kicker">Mission facts</span>
    <table class="table" style="margin-top:var(--space-2)">
      <tbody>
        <tr><td class="text-muted">Days since launch</td><td>{{ probe.daysSinceLaunch }}</td></tr>
        <tr><td class="text-muted">Location</td><td>{{ probe.location }}</td></tr>
        <tr><td class="text-muted">Constellation</td><td>{{ probe.constellation }}</td></tr>
        <tr><td class="text-muted">Heliopause crossing</td><td>{{ probe.heliopauseCrossingLabel }}</td></tr>
        <tr><td class="text-muted">Round-trip light time</td><td>{{ probe.roundTripLightTime }}</td></tr>
        <tr><td class="text-muted">Power source</td><td>{{ probe.powerSource }}</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="card elev-sm detail-dsn">
  <span class="card-kicker">Deep Space Network link</span>
  {% if probe.inContact %}
  <table class="table" style="margin-top:var(--space-2)">
    <tbody>
      <tr><td class="text-muted">Dish</td><td>{{ probe.dsnDishName }} &middot; {{ probe.dishLocation }}{% if probe.dishFlagSrc %} <img src="{{ probe.dishFlagSrc }}" alt="{{ probe.dishFlagAlt }}" class="flag-icon">{% endif %}</td></tr>
      <tr><td class="text-muted">Direction</td><td>{{ probe.dsnDirectionLabel }}</td></tr>
      <tr><td class="text-muted">Signal type</td><td>{{ probe.dsnSignalType }}</td></tr>
      <tr><td class="text-muted">Data rate</td><td>{{ probe.dsnDataRateLabel }}{% if probe.dsnDataRateLabel %} <span class="text-muted" style="font-size:11px">&middot; bps = bits per second{% if probe.dsnDataRateContext %} &middot; {{ probe.dsnDataRateContext }}{% endif %}</span>{% endif %}</td></tr>
      <tr><td class="text-muted">Band</td><td>{{ probe.dsnBand }}{% if probe.dsnBandFrequency %} <span class="text-muted" style="font-size:11px">&middot; {{ probe.dsnBandFrequency }}</span>{% endif %}</td></tr>
      <tr><td class="text-muted">Signal power</td><td>{{ probe.dsnPowerLabel }}{% if probe.dsnPowerContext %} <span class="text-muted" style="font-size:11px">&middot; {{ probe.dsnPowerContext }}</span>{% endif %}</td></tr>
    </tbody>
  </table>
  {% else %}
  <p class="card-body" style="opacity:.75;margin-top:var(--space-2)">No DSN dish is currently in contact with {{ probe.name }} &mdash; this is normal dish-scheduling behavior, not an error. Live link details will appear here again once a pass begins.</p>
  {% endif %}
</div>

<div class="card elev-sm detail-instruments">
  <span class="card-kicker">Instrument health</span>
  <table class="table" style="margin-top:var(--space-2)">
    <thead><tr><th>Instrument</th><th>Status</th></tr></thead>
    <tbody>
      {% for instrument in probe.instruments %}
      <tr>
        <td>{{ instrument.name }}</td>
        <td>
          {% if instrument.active %}
            <span class="tag tag-accent">Active</span>
          {% else %}
            <span class="tag tag-neutral">Off{% if instrument.note %} &mdash; {{ instrument.note }}{% endif %}</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="text-muted" style="font-size:11px;margin-top:var(--space-2)">Not live telemetry &mdash; transcribed from NASA's own status page, updated by hand when it changes. <a href="https://science.nasa.gov/mission/voyager/where-are-voyager-1-and-voyager-2-now/" target="_blank" rel="noopener">Source: science.nasa.gov <i class="ph ph-arrow-up-right"></i></a></p>
</div>

{% include '_footer.twig' with {updatedLabel: probe.updatedLabel, stale: probe.stale} %}

{% endblock %}
