{% extends "layout.twig" %}

{% block title %}{{ probe.name }} — Voyager Distance Tracker{% endblock %}

{% block content %}

<a href="/" class="back-link"><i class="ph ph-arrow-left"></i>Back to overview</a>

<div class="page-header">
  <div>
    <h6 style="color:var(--color-accent)">SPACECRAFT</h6>
    <h1 style="margin:0 0 4px">{{ probe.name }}</h1>
    <p class="text-muted" style="margin:0;font-size:13px">Launched {{ probe.launchDateLabel }} &middot; {{ probe.subtitleFact }}</p>
  </div>
  <span class="tag {{ probe.inContact ? 'tag-accent' : 'tag-neutral' }}" style="font-size:12px"><i class="ph ph-broadcast"></i>{{ probe.signalLabel }}</span>
</div>

<div class="detail-stats">
  <div class="card elev-sm"><span class="card-kicker">Dist. from Sun</span><div class="detail-stat-value detail-stat-value-precise">{{ probe.distanceFromSunPrecise }}</div></div>
  <div class="card elev-sm"><span class="card-kicker">Dist. from Earth</span><div class="detail-stat-value detail-stat-value-precise">{{ probe.distanceFromEarthPrecise }}</div></div>
  <div class="card elev-sm">
    <span class="card-kicker">Speed</span>
    <div class="detail-stat-value">{{ probe.speed }}</div>
    <div class="text-muted detail-stat-sub">{{ probe.speedKmH }} &middot; {{ probe.speedMph }}</div>
  </div>
  <div class="card elev-sm"><span class="card-kicker">One-way light time</span><div class="detail-stat-value">{{ probe.oneWayLightTime }}</div></div>
</div>

<div class="detail-two-col">

  <div class="card elev-sm" style="padding:var(--space-4)">
    <span class="card-kicker">Position &amp; heading</span>
    <svg width="100%" height="220" viewBox="0 0 400 220" style="display:block;margin:var(--space-2) 0">
      <circle cx="20" cy="110" r="9" fill="var(--color-accent)"/>
      <text x="8" y="135" font-size="10" fill="var(--color-neutral-500)">Sun</text>
      <circle cx="70" cy="110" r="3" fill="var(--color-neutral-300)"/>
      <text x="60" y="128" font-size="9" fill="var(--color-neutral-500)">Earth</text>
      <line x1="20" y1="110" x2="380" y2="110" stroke="var(--color-divider)" stroke-dasharray="2 5"/>
      <circle cx="380" cy="110" r="5" fill="var(--color-accent)" class="pulse-dot {{ probe.inContact ? '' : 'is-dormant' }}"/>
      <text x="330" y="95" font-size="12" fill="var(--color-text)">{{ probe.name }}</text>
      <text x="310" y="145" font-size="10" fill="var(--color-neutral-500)">{{ probe.distanceFromSun }} from Sun</text>
    </svg>
    <p class="card-body" style="opacity:.75">Heading {{ probe.heading }}. Left the heliopause on {{ probe.heliopauseCrossingLabel }} and is now in interstellar space.</p>
  </div>

  <div class="card elev-sm" style="padding:var(--space-4)">
    <span class="card-kicker">Mission facts</span>
    <table class="table" style="margin-top:var(--space-2)">
      <tbody>
        <tr><td class="text-muted">Days since launch</td><td>{{ probe.daysSinceLaunch }}</td></tr>
        <tr><td class="text-muted">Location</td><td>{{ probe.location }}</td></tr>
        <tr><td class="text-muted">Constellation</td><td>{{ probe.constellation }}</td></tr>
        <tr><td class="text-muted">Heliopause crossing</td><td>{{ probe.heliopauseCrossingLabel }}</td></tr>
        <tr><td class="text-muted">Round-trip light time</td><td>{{ probe.roundTripLightTime }}</td></tr>
        <tr><td class="text-muted">Power source</td><td>{{ probe.powerSource }}</td></tr>
      </tbody>
    </table>
  </div>
</div>

<div class="card elev-sm detail-instruments">
  <span class="card-kicker">Instrument health</span>
  <table class="table" style="margin-top:var(--space-2)">
    <thead><tr><th>Instrument</th><th>Status</th></tr></thead>
    <tbody>
      {% for instrument in probe.instruments %}
      <tr>
        <td>{{ instrument.name }}</td>
        <td>
          {% if instrument.active %}
            <span class="tag tag-accent">Active</span>
          {% else %}
            <span class="tag tag-neutral">Off{% if instrument.note %} &mdash; {{ instrument.note }}{% endif %}</span>
          {% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="text-muted" style="font-size:11px;margin-top:var(--space-2)">Illustrative wireframe data &mdash; not live values.</p>
</div>

{% include '_footer.twig' with {updatedLabel: probe.updatedLabel, stale: probe.stale} %}

{% endblock %}
