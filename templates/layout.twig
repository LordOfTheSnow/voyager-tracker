<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Voyager Distance Tracker{% endblock %}</title>
<link rel="icon" type="image/svg+xml" href="/assets/img/favicon.svg">
<link rel="stylesheet" href="/assets/css/app.css">
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css">
<script defer src="/assets/js/app.js"></script>
<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
{% block head %}{% endblock %}
</head>
<body>
<div class="page">
  <header class="nav-bar">
    <nav class="nav">
      <span class="nav-brand"><i class="ph ph-planet"></i>Voyager Distance Tracker<span class="nav-version">v{{ appVersion }}</span></span>
      <a href="/" {% if active == 'home' %}aria-current="page"{% endif %}>Home</a>
      <a href="/voyager-1" {% if active == 'voyager-1' %}aria-current="page"{% endif %}>Voyager 1</a>
      <a href="/voyager-2" {% if active == 'voyager-2' %}aria-current="page"{% endif %}>Voyager 2</a>
      <a href="/milestones" {% if active == 'milestones' %}aria-current="page"{% endif %}>Milestones</a>
      <a href="/about" {% if active == 'about' %}aria-current="page"{% endif %}>About</a>
      <a href="/sources" {% if active == 'sources' %}aria-current="page"{% endif %}>Sources</a>
    </nav>
  </header>

  <main class="page-main">
    {% block content %}{% endblock %}
  </main>
</div>
</body>
</html>
